# daily.news 环境变量
# 复制成 .env 后填值。.env 不入 git（Bun 启动时自动加载）。
#
# 非密钥配置在 res/config/*.yml；这里只放不该进 git 的东西，以及临时覆盖。
# 键名规则：APP_ + 点分路径，`.` 换成 `__`（APP_SERVER__WEB_PORT → server.web_port）

# --- 调试面板（/shell）---
# 两个都填才会挂面板；缺一个就整块不挂（没配面板比挂一个没人管的入口安全）
APP_SHELL__USER=
APP_SHELL__PASSWORD=
# 面板 token 的签名密钥。不配则每次重启随机生成，已登录的浏览器全部掉线
APP_SHELL__SECRET=

# --- 服务（通常不用动，改 res/config/common.yml 更合适）---
# APP_SERVER__WEB_PORT=5003
# APP_SERVER__HOST=0.0.0.0
# APP_DATA__DIR=~/Documents/daily-news
# APP_LOGGER__FILTER_LEVEL=info
# JWT 验签密钥。全站匿名，没有签发方，留空即可（只解不验）
# APP_AUTH__SECRET=

# --- 模型通道 ---
# 主通道 key 从 ~/.zshrc.sh 的 DEEPSEEK_API_KEY 自动读取，无需在这里重复
# APP_MODEL__PRIMARY__PROVIDER=deepseek
# APP_MODEL__PRIMARY__MODEL=deepseek-flash
# 兜底通道凭证在 ~/.pi/agent/auth.json
# APP_MODEL__FALLBACK__PROVIDER=zai-coding-cn
# APP_MODEL__FALLBACK__MODEL=glm-5.3-flash
