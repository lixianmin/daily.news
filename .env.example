# daily.news 环境变量
# 复制成 .env 后填值。.env 不入 git。

# --- 调试控制台凭据（/console）---
# 不配的话 /console 会拒绝所有登录（这是安全默认，不是 bug）
CONSOLE_USER=xmli
CONSOLE_PASSWORD=
# 不配则每次重启后登录态失效，需要重新 auth
CONSOLE_SECRET=

# --- 服务 ---
# DAILY_NEWS_PORT=5003
# DAILY_NEWS_HOST=0.0.0.0
# DAILY_NEWS_DATA_DIR=~/Documents/daily-news
# JWT 验签密钥。留空 = 只解不验（还没登录，没有签发方）
# DAILY_NEWS_JWT_SECRET=

# --- 模型通道 ---
# 主通道 key 从 ~/.zshrc.sh 的 DEEPSEEK_API_KEY 自动读取，无需在这里重复
# PRIMARY_PROVIDER=deepseek
# PRIMARY_MODEL=deepseek-flash
# 兜底通道凭证在 ~/.pi/agent/auth.json
# FALLBACK_PROVIDER=zai-coding-cn
# FALLBACK_MODEL=glm-5.3-flash
